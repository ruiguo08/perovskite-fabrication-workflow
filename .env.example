# Copy values into the service environment; do not commit the real file.
POSTGRES_DB=perovskite_registry
POSTGRES_USER=perovskite_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
PEROVSKITE_DATABASE_URL=postgresql+asyncpg://perovskite_app:URL_ENCODED_PASSWORD@127.0.0.1:5432/perovskite_registry
# Local/CI test process only; do not add this credential to the application service.
PEROVSKITE_TEST_POSTGRESQL_URL=postgresql+asyncpg://perovskite_test:URL_ENCODED_PASSWORD@127.0.0.1:5432/perovskite_test
PEROVSKITE_ALLOWED_HOSTS=127.0.0.1,localhost,perovskite.office.example
PEROVSKITE_REQUIRE_HTTPS=true
PEROVSKITE_ENABLE_DOCS=false
PEROVSKITE_FORWARDED_ALLOW_IPS=127.0.0.1,::1
PEROVSKITE_SESSION_HOURS=12
PEROVSKITE_SESSION_IDLE_MINUTES=120
