# Install as /etc/perovskite/perovskite.env with mode 0600.
PEROVSKITE_DATABASE_URL=postgresql+asyncpg://perovskite_app:replace-with-url-encoded-runtime-password@127.0.0.1:5432/perovskite_registry
PEROVSKITE_ALLOWED_HOSTS=perovskite.lab.example
PEROVSKITE_REQUIRE_HTTPS=true
PEROVSKITE_ENABLE_DOCS=false
PEROVSKITE_FORWARDED_ALLOW_IPS=127.0.0.1,::1
PEROVSKITE_LOG_LEVEL=INFO
