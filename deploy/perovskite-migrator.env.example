# Install as /etc/perovskite/perovskite-migrator.env with mode 0600 and owner perovskite-migrator.
# This credential is used only by the one-shot migration service.
PEROVSKITE_MIGRATION_DATABASE_URL=postgresql+asyncpg://perovskite_migrator:replace-with-url-encoded-migration-password@127.0.0.1:5432/perovskite_registry
